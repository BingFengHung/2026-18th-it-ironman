    {
        "id": "170af4dc9d2e649c",
        "type": "function",
        "z": "b28b84fe6d94f162",
        "name": "1. 建立 agy 指令",
        "func": "const prompt = msg.prompt || (typeof msg.payload === 'string' ? msg.payload : JSON.stringify(msg.payload));\nlet cmd = `agy -p ${JSON.stringify(prompt)} --dangerously-skip-permissions`;\n\nif (msg.schema) {\n    const schemaStr = typeof msg.schema === 'object' ? JSON.stringify(msg.schema) : msg.schema;\n    cmd += ` --json-schema ${JSON.stringify(schemaStr)} --output-format json`;\n}\n\nmsg.payload = cmd;\nreturn msg;",
        "outputs": 1,
        "x": 220,
        "y": 80,
        "wires": [
            [
                "542ead227534f6e1"
            ]
        ]
    },
    {
        "id": "e5605464b6cc3522",
        "type": "function",
        "z": "b28b84fe6d94f162",
        "name": "3. 雙軌解包",
        "func": "let parsed;\ntry {\n    parsed = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n} catch (e) {\n    parsed = { response: msg.payload };\n}\n\nlet result = parsed.structured_output;\nif (!result && parsed.response) {\n    try {\n        result = typeof parsed.response === 'string' ? JSON.parse(parsed.response) : parsed.response;\n    } catch (e) {\n        result = parsed.response;\n    }\n}\n\nmsg.payload = result || parsed;\nreturn msg;",
        "outputs": 1,
        "x": 620,
        "y": 80,
        "wires": [
            []
        ]
    },
